# ==========================================================================
#  SignalPro — configuration serveur. Copiez en .env et remplissez.
#  Aucun secret ne doit être committé : .env est ignoré par git.
# ==========================================================================

ENV=dev
PUBLIC_BASE_URL=http://localhost:8000

# --- Base de données ------------------------------------------------------
# dev : SQLite. production : PostgreSQL obligatoire.
DATABASE_URL=sqlite:///./signalpro.db
# DATABASE_URL=postgresql+psycopg://signalpro:motdepasse@db:5432/signalpro

# --- Secrets (générez-les : python -m app.config) -------------------------
JWT_SECRET=
FIELD_KEY_B64=
FINGERPRINT_KEY=
CONNECTOR_SHARED_SECRET=

# --- Stockage des preuves -------------------------------------------------
STORAGE_BACKEND=local
STORAGE_DIR=./var/evidence
# STORAGE_BACKEND=s3
# S3_BUCKET=signalpro-preuves
# S3_REGION=eu-west-3
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# --- Vérification obligatoire des comptes (email / SMS) ------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@votre-domaine.tld
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
ALLOW_CONSOLE_VERIFICATION=false

# --- WhatsApp Business Platform (comptes professionnels) ------------------
CLOUD_API_VERSION=v21.0
CLOUD_API_PHONE_NUMBER_ID=
CLOUD_API_TOKEN=
CLOUD_API_APP_SECRET=
CLOUD_API_VERIFY_TOKEN=

# --- Passerelle WhatsApp de l'utilisateur (dossier gateway/) --------------
CONNECTOR_BASE_URL=http://127.0.0.1:8787
CONNECTOR_REMOTE_MODE=false

# --- Canal officiel pour les dossiers (obligatoire pour l'escalade) -------
# Adresse de signalement d'abus de votre compte WhatsApp Business.
META_ABUSE_ESCALATION_EMAIL=

# --- Limites anti-abus (modifiables, jamais désactivables) ---------------
MAX_REPORTS_PER_HOUR_USER=5
MAX_REPORTS_PER_DAY_USER=20
MAX_ACTIONS_PER_MINUTE_USER=10
MAX_ABUSIVE_STRIKES=2
MIN_VERIFICATIONS_TO_PUBLISH=3
MIN_VERIFICATIONS_TO_ESCALATE=3
MAX_PAIRING_PER_DAY=3
CAMPAIGN_HARD_CAP=500
RETENTION_DAYS_EVIDENCE=730

# --- Divers ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DOCS_ENABLED=true
