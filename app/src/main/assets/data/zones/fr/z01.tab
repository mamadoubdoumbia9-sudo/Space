# [Z01] LE CABINET VASSEUR — Port-Cendre, rue des Saleurs
zone z01
name Le Cabinet Vasseur
subtitle rue des Saleurs, Port-Cendre
act 1
palette papier
music track_02
ambience amb_cabinet
open true
map 0.21 0.60
start t01

tableau t01 "La boutique des cartes"
image art/zones/z01_t01.jpg
prop interior 1
prop particles dust
prop filou_x 0.30
prop filou_y 0.92
enter_thought z01.boutique
enter_scene sq02_ombeline [SI: seen:prologue_reve & !seen:sq02_ombeline]
npc ombeline 0.60 0.86 [SI: act<4 | letter_read]
hot EXAMINE table_cartes 0.42 0.66 "La grande table" think=z01.table sniff=lit
hot EXAMINE horloge_marine 0.72 0.13 "L'horloge marine" think=z01.horloge sniff=horloge_marine
hot EXAMINE carte_murale 0.55 0.25 "La carte murale de la presqu'île" think=z01.carte_murale
hot EXAMINE tiroirs 0.68 0.44 "Le meuble à tiroirs" think=z01.tiroirs
hot PUZZLE E01 0.80 0.52 "Le tiroir des effacés" [SI: seen:sq02_ombeline] done=z01.tiroir_fait
hot READ archive_carnet_ombeline 0.35 0.50 "Le carnet d'Ombeline" archive=AR-06 [SI: seen:sq02_ombeline]
hot EXAMINE theodolite 0.50 0.35 "Le théodolite" think=z01.theodolite
hot TAKE gomme_rouge 0.47 0.70 "Une gomme rouge, biseautée" think=z01.gomme [SI: seen:sq02_ombeline]
hot READ page1 0.36 0.60 "Une feuille bleu nuit, sous la table" page=1 [SI: seen:sq02_ombeline]
hot MURMURE M-17 0.57 0.22 "Une tache de bougie sur le plan de 1889" lens=1
hot MURMURE M-18 0.66 0.58 "Le trousseau du tiroir du bas" lens=1
hot SECRET s11_z01 0.10 0.55 "Une ombre dans l'embrasure" lens=1 -> flag s11_z01 ; thought secret.s11_seen ; sfx chat_miaule
hot EXAMINE porte_ouverte 0.12 0.45 "La porte ouverte sur la rue" think=z01.porte
path t02 "L'atelier" 0.93 0.55 kind=door
path t03 "La chambre" 0.88 0.20 kind=door hidden
path z02 "Sortir dans la rue" 0.12 0.75 [SI: seen:sq02_ombeline] locked=z01.pas_encore back

