hot EXAMINE journal_boite 0.15 0.62 "Le journal de veille, dans la niche" think=z12.journal_niche
hot LISTEN mer_bas 0.90 0.80 "La mer, en bas" think=z12.mer_bas sfx=mer_lointaine
path t01 "Redescendre le chemin" 0.06 0.80 back
path z13 "Entrer dans le phare" 0.50 0.72 kind=door [SI: flag:marek_porte_ouverte] locked=z12.porte_fermee
