<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Protection de la vie privée : interdiction d'extraire les données d'enquête et clés sécurisées -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
