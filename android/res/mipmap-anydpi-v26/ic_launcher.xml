<?xml version="1.0" encoding="utf-8"?>
<!--
  Icone adaptative (API 26 et plus) : la nuit en fond, le Phare en premier plan.
  Le premier plan est rasterise dans la zone sure de 72 dp sur 108 dp, donc le
  masquage — carre, rond ou squircle — ne coupe jamais la lanterne.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/lohen_icon_bg" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
