# ==========================================================================
#  Passerelle locale SignalPro — configuration
#  Copiez ce fichier en .env dans le dossier gateway/ et remplissez-le.
#  ATTENTION : ce .env contient le secret partagé avec le backend. Ne le
#  committez jamais et ne le copiez jamais sur un serveur distant.
# ==========================================================================

GATEWAY_PORT=8787
# Par défaut la passerelle n'écoute que sur la boucle locale.
GATEWAY_HOST=127.0.0.1

# Doit être IDENTIQUE à CONNECTOR_SHARED_SECRET côté backend.
# Générez-le avec :  python -m app.config
GATEWAY_SHARED_SECRET=

# Dossier où sont stockées les clés de session WhatsApp (multi-appareils).
GATEWAY_SESSION_DIR=./sessions

# ---------------------------------------------------------------------------
# Signalement natif automatique — DÉSACTIVÉ PAR DÉFAUT
#
#   false (recommandé) : l'application affiche un parcours guidé pas-à-pas ;
#                        l'utilisateur effectue lui-même le signalement dans
#                        WhatsApp. Aucun risque d'automatisation.
#
#   true (expérimental) : la passerelle pilote le menu « Signaler » de la même
#                        session WhatsApp Web. WhatsApp peut modifier son
#                        interface à tout moment, ce qui rend l'action
#                        impossible (elle est alors signalée comme non
#                        effectuée), et l'automatisation d'actions de compte
#                        comporte un risque de restriction du compte.
#
#  Dans tous les cas : aucun contournement de limite, aucune action de masse.
# ---------------------------------------------------------------------------
GATEWAY_ENABLE_NATIVE_REPORT=false
